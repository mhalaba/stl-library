# Copy to .env and fill in. The .env file is not versioned.

# --- Application secret ------------------------------------------------------
# Signs session cookies and download links. Generate once, then leave it alone:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
STL_SECRET_KEY=

# --- File signing keys (python3 tools/keygen.py) ------------------------------
# Public key - always on the server. Used for verification, meant to be public.
STL_SIGNING_PUBLIC_KEY=

# Private key - ONLY if you deliberately choose online mode.
# In offline mode (recommended for production) leave this empty or delete the
# line, and sign files from a separate machine with tools/sign_pending.py
STL_SIGNING_PRIVATE_KEY=

# Publisher name written into every manifest (part of the signed data).
STL_PUBLISHER=stl-library

# --- First administrator account ---------------------------------------------
# Created on first start if it does not exist. Once the account exists you can
# remove both variables.
STL_ADMIN_EMAIL=
STL_ADMIN_PASSWORD=

# --- Settings ----------------------------------------------------------------
STL_DATA_DIR=./data
STL_MAX_UPLOAD_MB=256
STL_SESSION_TTL=1209600
STL_DOWNLOAD_TTL=300
STL_LOGIN_MAX_ATTEMPTS=10
STL_LOGIN_WINDOW=900
STL_ALLOW_REGISTRATION=true

# Interface and API language when the visitor expresses no preference: en or pl.
STL_DEFAULT_LANGUAGE=en

# Cookies over HTTPS only. Set to false on localhost.
STL_COOKIE_SECURE=true
