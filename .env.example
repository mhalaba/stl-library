# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium.

# --- Sekret aplikacji --------------------------------------------------------
# Podpisuje ciasteczka sesji i linki do pobrania. Wygeneruj raz i nie zmieniaj:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
STL_SECRET_KEY=

# --- Klucze podpisu plików (python3 tools/keygen.py) -------------------------
# Publiczny — zawsze na serwerze. Służy do weryfikacji, jest jawny.
STL_SIGNING_PUBLIC_KEY=

# Prywatny — TYLKO jeśli świadomie wybierasz tryb online.
# W trybie offline (zalecanym w produkcji) zostaw tę linię pustą lub usuń,
# a pliki podpisuj z osobnej maszyny: tools/sign_pending.py
STL_SIGNING_PRIVATE_KEY=

# Nazwa wydawcy wpisywana do każdego manifestu (część podpisywanych danych).
STL_PUBLISHER=biblioteka-stl

# --- Pierwsze konto administratora -------------------------------------------
# Zakładane przy pierwszym starcie, jeśli nie istnieje. Po utworzeniu konta
# możesz obie zmienne usunąć.
STL_ADMIN_EMAIL=
STL_ADMIN_PASSWORD=

# --- Ustawienia --------------------------------------------------------------
STL_DATA_DIR=./data
STL_MAX_UPLOAD_MB=256
STL_SESSION_TTL=1209600
STL_DOWNLOAD_TTL=300
STL_LOGIN_MAX_ATTEMPTS=10
STL_LOGIN_WINDOW=900
STL_ALLOW_REGISTRATION=true

# Ciasteczka tylko po HTTPS. Na localhoscie ustaw false.
STL_COOKIE_SECURE=true
